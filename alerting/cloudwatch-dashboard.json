{
  "widgets": [
    {
      "type": "metric",
      "x": 0,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "EC2 CPU utilization",
        "view": "timeSeries",
        "region": "${region}",
        "period": 300,
        "stat": "Average",
        "metrics": [
          [
            "AWS/EC2",
            "CPUUtilization",
            "InstanceId",
            "${instance_id}"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Database operation errors",
        "view": "timeSeries",
        "region": "${region}",
        "period": 300,
        "stat": "Sum",
        "metrics": [
          [
            "ToDoListApi",
            "DatabaseOperationErrors",
            "Service",
            "${service}"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Tasks created",
        "view": "timeSeries",
        "region": "${region}",
        "period": 300,
        "stat": "Sum",
        "metrics": [
          [
            "ToDoListApi",
            "TasksCreated",
            "Service",
            "${service}"
          ]
        ]
      }
    }
  ]
}